GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash            # groundedCheck only: needs Search grounding quota (free tier: 2.5 Flash yes, 3.x no)
GEMINI_MATCH_MODEL=      # transcribeVideo + matchAgainstAlerts; defaults to GEMINI_MODEL
SOLANA_RPC_URL=https://api.devnet.solana.com
AGENCY_HAMILTON_EMA_SECRET=   # base58 secret key
AGENCY_NWS_CIN_SECRET=        # base58 secret key
REGISTRY_MODE=memo            # memo | anchor — anchor publishes through the crisis_registry program
REGISTRY_PROGRAM_ID=82xaA9hPGxDtdT98EZGTjyjyt1HQaM81nm5MFCzF94hz
REGISTRY_ADMIN_SECRET=        # base58; printed by scripts/setup-registry.ts (only that script uses it)
ADMIN_PASSWORD=               # gates /publish and the admin API routes; empty = no one can log in
DATABASE_URL=                 # optional Tiger Data (Postgres) URL; empty = JSON files in data/
DATABASE_CA_CERT=             # path to the Tiger Data CA PEM (ca.timescale.com); the cert is always verified
# Optional Auth0 admin login (leave AUTH0_DOMAIN empty for password-only)
AUTH0_DOMAIN=                 # e.g. your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                 # 32+ random bytes, hex: openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
ADMIN_EMAILS=                 # comma-separated; only verified Auth0 emails on this list are admins
